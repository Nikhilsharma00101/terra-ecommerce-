# Public Site URL for SEO and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.terramensco.com

# Cloudinary Configuration (For product images & media uploads)
# NOTE: Created using the info@terramensco id
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# MongoDB Connection String (MongoDB Atlas or local URI)
# NOTE: Created using the info@terramensco id
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret for Auth & Secure HTTP-Only Cookie Session Encryption
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_at_least_32_characters

# Google OAuth Configuration
# NOTE: Created using the lavinlavi id
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Razorpay Payment Gateway
# NOTE: Created using the lavinlavi id
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email SMTP Configuration
# NOTE: Created using the info@terramensco id
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=your_smtp_user
EMAIL_SERVER_PASSWORD=your_smtp_password
EMAIL_FROM=your_email@example.com

# Admin Configuration
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
